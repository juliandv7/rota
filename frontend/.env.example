# URL del backend al que el servidor de Vite reenvía /api (proxy de desarrollo).
VITE_BACKEND_URL=http://localhost:8080

# Opcional para probar la cámara desde un celular en la red local.
# El certificado debe incluir la IP local de la computadora y ser confiable para el celular.
VITE_HTTPS_KEY_PATH=
VITE_HTTPS_CERT_PATH=
